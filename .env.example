# Documentation template — copy to `.env.local` for dev or `.env.production`
# for prod, then populate the values. `.env.example` itself is committed;
# `.env.local` and `.env.production` are gitignored.
#
# Values are double-quoted so DSNs and other strings containing shell
# metacharacters (`(`, `)`, `&`, `?`, `=`) round-trip correctly through
# `set -a && . ./.env.<variant> && set +a`.

# Server addresses.
HTTP_ADDR=":8080"
MAX_BODY_BYTES="1048576"

# Logging. Runtime log verbosity — one of debug | info | warn | error
# (default info). Read at boot via cfg.SlogLevel(); no recompile needed.
LOG_LEVEL="info"

# Field-level encryption keys (32-byte hex). Generated fresh in .env.local
# at init time; production should use a separate pair from your secrets
# manager. Leave empty when no `encrypted: true` field is in any spec —
# the encryptor stays nil, no boot-time validation kicks in.
ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""
# Zero-downtime AES key rotation: set ENCRYPTION_KEY to the NEW key and
# ENCRYPTION_KEY_OLD to the current (old) key. Both keys are tried on
# decrypt so ciphertext written with the old key still reads during the
# rollout window (mirrors INTERSVC_AUTH_KEY_OLD below). Once every row has
# been re-encrypted with the new primary key, unset ENCRYPTION_KEY_OLD.
ENCRYPTION_KEY_OLD=""

# Inter-service JWT auth key (32-byte hex; generate with `openssl rand
# -hex 32`). Required when this service signs / verifies tokens across
# service-to-service hops via runtime/intersvcauth. The SAME key must
# be set on every service that participates in the call graph. Leave
# empty to disable inter-service auth (operators that don't need it
# pay no boot-time cost).
INTERSVC_AUTH_KEY=""
# Zero-downtime key rotation: set INTERSVC_AUTH_KEY to the NEW key and
# INTERSVC_AUTH_KEY_OLD to the current (old) key. Both keys will be
# accepted during the rotation window (see runtime/intersvcauth godoc
# for the WithVerifierFallbackKeys wiring). Once all services have been
# redeployed with the new primary key, unset INTERSVC_AUTH_KEY_OLD.
INTERSVC_AUTH_KEY_OLD=""
# @hexago:env:base

# PostgreSQL. Default DSN targets the docker-compose'd `postgres` service
# (see docker-compose.yml). Production: replace with your managed
# Postgres URL (sslmode=require recommended).
# `hexago init` writes a ready-to-run .env.local with a random per-project
# password (also in the gitignored .env); CHANGE_ME is a placeholder.
POSTGRES_DSN="postgres://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable"
DATABASE_URL=""
DATABASE_NAME="learnlab"
# @hexago:env:database
# @hexago:env:storage
# @hexago:env:eventbus
# @hexago:env:auth
# @hexago:env:custom
